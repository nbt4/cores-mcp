ADDRESS=:8090
MCP_PUBLIC_URL=https://cores.example.com
CORES_DASHBOARD_PUBLIC_URL=https://cores.example.com
MCP_AUTH_MODE=oauth
CORES_JWT_SECRET=replace-with-the-same-strong-secret-as-cores-dashboard

DB_HOST=postgres
DB_PORT=5432
DB_NAME=rentalcore
DB_USER=cores_mcp
DB_PASSWORD=replace-with-a-dedicated-read-only-password
DB_SSLMODE=disable

MCP_OAUTH_DATA_FILE=/var/lib/cores-mcp/oauth/clients.json
MCP_KNOWLEDGE_DIRS=/app/knowledge,/knowledge/cores
MCP_MAX_ROWS=200
MCP_QUERY_TIMEOUT=8s
MCP_RATE_LIMIT_PER_MINUTE=120
MCP_ALLOWED_ORIGINS=
TRUST_PROXY_HEADERS=true

RENTALCORE_URL=http://rentalcore:8081
WAREHOUSECORE_URL=http://warehousecore:8082
PLANNERCORE_URL=http://plannercore:8080
PROCUREMENTCORE_URL=http://procurementcore:8084

# Optional for non-interactive agents. Format: name:secret,name2:secret2
MCP_STATIC_TOKENS=
